# FlowOS Service Configuration
#
# This file tells FLOWOS_CORE to use FlowOS's full-featured service implementations
# instead of the minimal/noop services built into FLOWOS_CORE.
#
# Usage:
#   1. Copy this file to your FLOWOS_CONFIG_DIR as flowos.toml
#   2. Or add to pyproject.toml under [tool.flowos_core.services]
#
# The services will be automatically discovered and loaded when you run:
#   - flowos run
#   - flowos_core serve (when run from flowos project)

[services]
# Core Services - Full-featured FlowOS implementations
database_service = "flowos.services.database.service:DatabaseService"
storage_service = "flowos.services.storage.local:LocalStorageService"
cache_service = "flowos.services.cache.service:ThreadingInMemoryCache"

# Authentication & Session Management
auth_service = "flowos.services.auth.service:AuthService"
session_service = "flowos.services.session.service:SessionService"

# Chat & Communication
chat_service = "flowos.services.chat.service:ChatService"

# State & Data Management
state_service = "flowos.services.state.service:StateService"
variable_service = "flowos.services.variable.service:VariableService"

# Background Processing
task_service = "flowos.services.task.service:TaskService"
job_queue_service = "flowos.services.job_queue.service:JobQueueService"

# Marketplace & Components
store_service = "flowos.services.store.service:StoreService"
shared_component_cache_service = "flowos.services.shared_component_cache.service:SharedComponentCacheService"

# Observability
telemetry_service = "flowos.services.telemetry.service:TelemetryService"
tracing_service = "flowos.services.tracing.service:TracingService"

# Note: settings_service is NOT configurable - it always uses the built-in implementation
# Note: mcp_composer_service uses the flowos_core implementation by default
