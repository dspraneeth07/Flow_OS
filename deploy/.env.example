DOMAIN=localhost
STACK_NAME=flowos-stack

TRAEFIK_PUBLIC_NETWORK=traefik-public
TRAEFIK_TAG=flowos-traefik
TRAEFIK_PUBLIC_TAG=traefik-public


# FlowOS backend configuration
FLOWOS_LOG_LEVEL=debug
FLOWOS_SUPERUSER=superuser
FLOWOS_SUPERUSER_PASSWORD=superuser
FLOWOS_NEW_USER_IS_ACTIVE=False


# FlowOS frontend configuration
BACKEND_URL=http://backend:7860

# RabbitMQ configuration
RABBITMQ_DEFAULT_USER=flowos
RABBITMQ_DEFAULT_PASS=flowos

# Database configuration
DB_USER=flowos
DB_PASSWORD=flowos
DB_HOST=db
DB_PORT=5432
DB_NAME=flowos

# DB configuration
POSTGRES_USER=flowos
POSTGRES_PASSWORD=flowos
POSTGRES_DB=flowos
POSTGRES_PORT=5432

# Flower configuration
# Disable until https://github.com/flowos-ai/flowos/pull/2655 gets released
#FLOWOS_CACHE_TYPE=redis
FLOWOS_REDIS_HOST=result_backend
FLOWOS_REDIS_PORT=6379
FLOWOS_REDIS_DB=0
FLOWOS_REDIS_EXPIRE=3600
FLOWOS_REDIS_PASSWORD=
FLOWER_UNAUTHENTICATED_API=True
BROKER_URL=amqp://flowos:flowos@broker:5672
RESULT_BACKEND=redis://result_backend:6379/0
C_FORCE_ROOT="true"


# PGAdmin configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
